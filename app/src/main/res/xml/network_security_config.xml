<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Local self-signed Mobile API certificates are verified using the
         server key from the QR invitation, without installing a user CA. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
